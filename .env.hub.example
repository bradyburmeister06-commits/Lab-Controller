# Hub deployment (.env.hub.example)
#
# Copy this file to `.env` on the HOME / SERVER computer that will run the
# website + SQLite database. The hub never talks to MCC or Arduino hardware;
# it only ingests data pushed from one or more collectors.
#
#   cp .env.hub.example .env
#
# Then edit the values below before starting the container.
#
# IMPORTANT: this file is for hub INFRASTRUCTURE configuration only. The hub's
# machine list is now stored in the database and built dynamically as
# collectors register over HTTP. Do NOT hard-code COLLECTOR_ID/COLLECTOR_NAME
# here for every lab machine — every collector ships with its own .env.

APP_NAME="Machine Research Backend"
APP_ENV=production

# Run as the hub: web UI, sysadmin dashboard, DB, ingest API for collectors.
APP_MODE=hub

# Persisted inside the container at /data (mounted as a Docker volume).
DATABASE_URL=sqlite:////data/machine_research.db

# Sysadmin login. CHANGE BOTH BEFORE EXPOSING ON A NETWORK.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Shared secret all collectors use to authenticate when registering, sending
# heartbeats, or pushing telemetry. Use the SAME value on every collector.
# Generate something long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTOR_API_TOKEN=change-me-collector-token

# Mark a collector "stale/offline" after this many seconds without a heartbeat.
COLLECTOR_STALE_AFTER_SECONDS=60

# CORS for any external web app calling the hub API. For Tailscale, list the
# Tailscale URL(s) of the dashboard consumer(s).
CORS_ORIGINS=*

# Default activation machine record (legacy single-machine activation flow).
# This is unrelated to the multi-collector registry.
DEFAULT_MACHINE_ID=machine-1
DEFAULT_INTERVAL_SECONDS=3600
ACTIVATION_DURATION_SECONDS=5
SCHEDULER_TIMEZONE=America/Chicago

# The hub never drives hardware; keep these at "mock" / simulator values.
MACHINE_CONTROLLER=mock
SENSOR_SIMULATOR=true
RELAY_CONTROLLER=mock
