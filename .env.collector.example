# Collector deployment (.env.collector.example)
#
# Copy this file to `.env` on the LAB / AUTOMATION computer that owns the
# Arduino sensors and MCC USB-1208FS-Plus relay board. The collector pushes
# readings and relay events to the hub over HTTP (typically via Tailscale).
#
#   cp .env.collector.example .env
#
# Then edit the values below before starting the container OR the Windows-
# native Python service. See the README "Two-machine Docker deployment" and
# "Windows-native collector for real MCC hardware" sections.

APP_NAME="Machine Research Backend"
APP_ENV=production

# Run as the collector.
APP_MODE=collector

# The collector keeps a small local SQLite buffer to track which readings
# have been shipped. Inside the container this is persisted at /data.
DATABASE_URL=sqlite:////data/machine_research.db

# --- Hub connection ----------------------------------------------------------
# Public dashboards live on the HUB, not here. Point at your hub's Tailscale
# URL or 100.x.y.z IP. Examples:
#   HUB_BASE_URL=http://100.64.1.10:8000
#   HUB_BASE_URL=https://lab-hub.tailnet-name.ts.net
HUB_BASE_URL=http://HOME_TAILSCALE_IP:8000

# MUST match the hub's COLLECTOR_API_TOKEN exactly.
COLLECTOR_API_TOKEN=change-me-collector-token

COLLECTOR_ID=collector-1
COLLECTOR_NAME="Lab Collector"

COLLECTOR_PUSH_INTERVAL_SECONDS=10
COLLECTOR_POLL_INTERVAL_SECONDS=5
COLLECTOR_REQUEST_TIMEOUT_SECONDS=10

# --- Hardware ----------------------------------------------------------------
# IMPORTANT: when running the collector inside a Linux Docker container,
# the MCC Universal Library (mcculw) is NOT available because it is a
# Windows-only driver. Leave RELAY_CONTROLLER=mock unless you are running
# the collector natively on Windows. See the README for the Windows-native
# collector path used for real MCC hardware.
RELAY_CONTROLLER=mock
MCC_BOARD_NUM=0
MCC_DIGITAL_PORT=FIRSTPORTB
RELAY_1_BIT=0
RELAY_2_BIT=1
RELAY_3_BIT=2
RELAY_ACTIVE_HIGH=true

# Arduino serial. SENSOR_SIMULATOR=true generates fake readings so you can
# verify hub<->collector wiring before connecting real hardware.
SENSOR_SIMULATOR=true
ARDUINO_1_PORT=/dev/ttyACM0
ARDUINO_1_NAME=arduino-1
ARDUINO_2_PORT=/dev/ttyACM1
ARDUINO_2_NAME=arduino-2
ARDUINO_BAUDRATE=9600
SENSOR_READ_TIMEOUT_SECONDS=2

# The collector container does not serve a public website, but FastAPI still
# binds an HTTP port for /api/health. CORS does not matter here.
CORS_ORIGINS=*
