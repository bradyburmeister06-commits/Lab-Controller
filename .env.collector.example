# Collector deployment (.env.collector.example)
#
# Copy this file to `.env` on the Windows lab computer that owns the Arduino
# sensors and the MCC USB-1208FS-Plus relay board. The collector pushes
# readings and relay events to the hub over HTTP (typically via Tailscale).
#
#   copy .env.collector.example .env
#
# DEFAULT TOPOLOGY (recommended):
#   - ONE Windows collector
#   - ONE MCC USB-1208FS-Plus
#   - THREE physical machines, each driven by an SSR on a different DIO bit
#     of the same MCC board:
#         machine/channel 1 -> relay-1 -> Port B0
#         machine/channel 2 -> relay-2 -> Port B1
#         machine/channel 3 -> relay-3 -> Port B2
#   The hub admin UI lets you set independent ON/OFF intervals per relay
#   for this collector — those map 1:1 to the three SSR channels.
#
# SCALE-OUT TOPOLOGY (only if you add more hardware nodes later):
#   Run additional Windows collectors, each with its own .env, its own
#   COLLECTOR_ID, and its own MCC board. The hub supports N collectors.
#
# IMPORTANT: every collector machine MUST have its own COLLECTOR_ID and
# COLLECTOR_NAME. Do not reuse the same ID across machines, or the hub will
# treat them as the same machine.
#
# See README "Windows Collector Quick Start" and "Windows-native collector
# for real MCC hardware" sections.

APP_NAME="Machine Research Backend"
APP_ENV=production

# Run as the collector. start-collector.bat refuses to start otherwise.
APP_MODE=collector

# Local SQLite buffer that tracks which readings have shipped to the hub.
# On Windows-native this is a path relative to the repo root.
DATABASE_URL=sqlite:///./data/machine_research.db

# --- Hub connection ----------------------------------------------------------
# Public dashboards live on the HUB, not here. Point at your hub's Tailscale
# URL or 100.x.y.z IP. Examples:
#   HUB_BASE_URL=http://100.64.1.10:8000
#   HUB_BASE_URL=https://lab-hub.tailnet-name.ts.net
# start-collector.bat will REFUSE to start while this still contains
# HOME_TAILSCALE_IP, YOUR_HUB_TAILSCALE_IP, "placeholder", or localhost.
HUB_BASE_URL=http://HOME_TAILSCALE_IP:8000

# MUST match the hub's COLLECTOR_API_TOKEN exactly. Generate a long random
# secret. start-collector.bat refuses the default placeholder value below.
COLLECTOR_API_TOKEN=change-me-collector-token

# --- Collector identity (REQUIRED) -------------------------------------------
# Use lowercase letters/digits/-/_/.; max 64 chars.
#
# In the default ONE-MCC-controls-three-machines topology, this single
# collector owns relay-1, relay-2, and relay-3 on its single MCC board:
COLLECTOR_ID=lab-mcc-controller
COLLECTOR_NAME="Lab MCC Controller"
#
# If you ever scale out to multiple hardware nodes, give each its own ID:
#   COLLECTOR_ID=lab-collector-a    COLLECTOR_NAME="Lab A"
#   COLLECTOR_ID=lab-collector-b    COLLECTOR_NAME="Lab B"
#   COLLECTOR_ID=lab-collector-c    COLLECTOR_NAME="Lab C"

# How often to push telemetry / heartbeat / poll for commands. Independent of
# relay schedule intervals (those are stored per-machine in the hub DB and
# editable from the admin UI).
COLLECTOR_PUSH_INTERVAL_SECONDS=10
COLLECTOR_POLL_INTERVAL_SECONDS=5
COLLECTOR_REQUEST_TIMEOUT_SECONDS=10

# --- Relay hardware (MCC USB-1208FS-Plus) ------------------------------------
# Set RELAY_CONTROLLER=mcc_usb1208fs_plus on the real Windows lab machine.
# Leave it as "mock" only if you are testing the hub<->collector wiring
# without real relays attached.
#
# In the default topology, ONE MCC board controls all three machines via
# three SSRs on Port B bits 0/1/2:
RELAY_CONTROLLER=mcc_usb1208fs_plus
MCC_BOARD_NUM=0
MCC_DIGITAL_PORT=FIRSTPORTB
RELAY_1_BIT=0
RELAY_2_BIT=1
RELAY_3_BIT=2
RELAY_ACTIVE_HIGH=true

# Arduino serial (Windows uses COMx names). SENSOR_SIMULATOR=true generates
# fake readings so you can verify hub<->collector wiring before connecting
# real hardware.
SENSOR_SIMULATOR=true
ARDUINO_1_PORT=COM3
ARDUINO_1_NAME=arduino-1
ARDUINO_2_PORT=COM4
ARDUINO_2_NAME=arduino-2
ARDUINO_BAUDRATE=9600
SENSOR_READ_TIMEOUT_SECONDS=2
# Optional. When set, a chamber id on the wire that disagrees is rejected, so a
# swapped COM port assignment fails loudly instead of mislabelling readings.
ARDUINO_1_CHAMBER_ID=
ARDUINO_2_CHAMBER_ID=
# Base reconnect delay; backs off linearly to 30s while a port stays unavailable.
SENSOR_RECONNECT_DELAY_SECONDS=2

# The collector does not serve a public website, but FastAPI still binds an
# HTTP port for /api/health on 8001. CORS does not matter here.
CORS_ORIGINS=*
