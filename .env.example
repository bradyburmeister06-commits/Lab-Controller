APP_NAME="Machine Research Backend"
APP_ENV=development
DATABASE_URL=sqlite:///./data/machine_research.db

# Deployment mode:
#   all_in_one  - default; single machine runs dashboards + sensors + relays
#   hub         - home/server: serves dashboards, stores DB, ingests from collector
#   collector   - lab/Windows: drives Arduino + MCC, pushes to hub via HTTP
APP_MODE=all_in_one

# Shared secret between hub and collector (set the SAME value on both machines)
COLLECTOR_API_TOKEN=change-me-collector-token

# Collector identity and where to find the hub (used in collector mode)
COLLECTOR_ID=collector-1
COLLECTOR_NAME="Lab Collector"
HUB_BASE_URL=http://localhost:8000
COLLECTOR_PUSH_INTERVAL_SECONDS=10
COLLECTOR_POLL_INTERVAL_SECONDS=5
COLLECTOR_REQUEST_TIMEOUT_SECONDS=10

# Comma-separated web app origins. For Tailscale, include your web app URL.
# Example: http://100.64.1.10:3000,http://machine-dashboard.tailnet-name.ts.net
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sysadmin dashboard credentials. Change these before exposing anything.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Machine schedule defaults
DEFAULT_MACHINE_ID=machine-1
DEFAULT_INTERVAL_SECONDS=3600
ACTIVATION_DURATION_SECONDS=5
SCHEDULER_TIMEZONE=America/Chicago

# Machine controller mode:
# mock = log activation only
# wol = Wake-on-LAN magic packet
# command = run a configured shell command
MACHINE_CONTROLLER=mock
WOL_MAC_ADDRESS=
COMMAND_ON=

# Arduino settings. Set SENSOR_SIMULATOR=true to test without hardware.
SENSOR_SIMULATOR=true
ARDUINO_1_PORT=/dev/ttyACM0
ARDUINO_1_NAME=arduino-1
ARDUINO_2_PORT=/dev/ttyACM1
ARDUINO_2_NAME=arduino-2
ARDUINO_BAUDRATE=9600
SENSOR_READ_TIMEOUT_SECONDS=2

# Expected Arduino line formats:
# temp=72.4,rh=48.1
# or JSON: {"temp":72.4,"rh":48.1}

# Relay controller mode:
#   mock                = log only, no hardware writes (default; works on Linux/Docker)
#   mcc_usb1208fs_plus  = drive 3 relays via MCC USB-1208FS-Plus DIO (Windows-only;
#                         requires MCC Universal Library / InstaCal and the mcculw package)
RELAY_CONTROLLER=mock
MCC_BOARD_NUM=0
MCC_DIGITAL_PORT=FIRSTPORTB
RELAY_1_BIT=0
RELAY_2_BIT=1
RELAY_3_BIT=2
RELAY_ACTIVE_HIGH=true
# Hard cap on any single relay activation, in seconds. Applies to the API,
# the local scheduler, and schedules pushed from the hub.
RELAY_MAX_ACTIVATION_SECONDS=300
