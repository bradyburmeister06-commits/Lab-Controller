APP_NAME="Machine Research Backend"
APP_ENV=development
DATABASE_URL=sqlite:///./data/machine_research.db

# Comma-separated web app origins. For Tailscale, include your web app URL.
# Example: http://100.64.1.10:3000,http://machine-dashboard.tailnet-name.ts.net
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sysadmin dashboard credentials. Change these before exposing anything.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Machine schedule defaults
DEFAULT_MACHINE_ID=machine-1
DEFAULT_INTERVAL_SECONDS=3600
ACTIVATION_DURATION_SECONDS=5
SCHEDULER_TIMEZONE=America/Chicago

# Machine controller mode:
# mock = log activation only
# wol = Wake-on-LAN magic packet
# command = run a configured shell command
MACHINE_CONTROLLER=mock
WOL_MAC_ADDRESS=
COMMAND_ON=

# Arduino settings. Set SENSOR_SIMULATOR=true to test without hardware.
SENSOR_SIMULATOR=true
ARDUINO_1_PORT=/dev/ttyACM0
ARDUINO_1_NAME=arduino-1
ARDUINO_2_PORT=/dev/ttyACM1
ARDUINO_2_NAME=arduino-2
ARDUINO_BAUDRATE=9600
SENSOR_READ_TIMEOUT_SECONDS=2

# Expected Arduino line formats:
# temp=72.4,rh=48.1
# or JSON: {"temp":72.4,"rh":48.1}
